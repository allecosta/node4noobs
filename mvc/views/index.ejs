<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Blog Posts</title>
    </head>
    <body>
        <h1>Blog Posts</h1>
        
        <ul>
            <% for (const post of posts) { %>
                <li>
                    <h2><%= post.title %></h2>
                    <p><%= post.content %></p>
                    <p>Author: <%= post.author %></p>
                </li>
            <% } %>
        </ul>
    </body>
</html>