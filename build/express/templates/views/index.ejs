<!DOCTYPE html>
<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <h1><%= title %></h1>
        <p><%= message %></p>
        
        <h2>Items:</h2>
        <ul>
            <% for (const item of items) { %>
                <li><%= item %></li>
            <% } %>
        </ul>
    </body>
</html>